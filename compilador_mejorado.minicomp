#Compilador Mejorado - Con operaciones aritmeticas y concatenacion de strings
#Thu Nov 05 20:46:15 GMT-03:00 2026
fases.hasta=4
formato=minicomp-1
lex.cantidad=0
lex.definiciones=
manual.cup=import java_cup.runtime.Symbol;\r\nimport java.io.FileReader;\r\nimport java.io.FileWriter;\r\nimport java.util.ArrayList;\r\nimport java.util.LinkedHashMap;\r\nimport java.util.List;\r\nimport java.util.Map;\r\n\r\nparser code {\:\r\n    Map<String, String> tablaDeSimbolos \= new LinkedHashMap<>();\r\n    List<String> erroresSemanticos \= new ArrayList<>();\r\n    StringBuilder datos \= new StringBuilder();\r\n    int contador \= 0;\r\n\r\n    static class Valor {\r\n        String tipo, codigo;\r\n        Valor(String tipo, String codigo) { this.tipo \= tipo; this.codigo \= codigo; }\r\n    }\r\n\r\n    static class DeclItem {\r\n        String id;\r\n        int linea;\r\n        Valor valor;\r\n        DeclItem(String id, int linea, Valor valor) {\r\n            this.id \= id; this.linea \= linea; this.valor \= valor;\r\n        }\r\n    }\r\n\r\n    void errorSemantico(int linea, String mensaje) {\r\n        erroresSemanticos.add("Error sem\u00E1ntico en l\u00EDnea " + linea + "\: " + mensaje);\r\n    }\r\n\r\n    String nuevaEtiqueta(String prefijo) {\r\n        return prefijo + (contador++);\r\n    }\r\n\r\n    Valor operarAritmetico(Valor a, Valor b, String op, int linea) {\r\n        if (\!a.tipo.equals("error") && \!b.tipo.equals("error")) {\r\n            if (\!a.tipo.equals("int") || \!b.tipo.equals("int")) {\r\n                errorSemantico(linea, "el operador '" + op + "' requiere operandos int, pero recibi\u00F3 " + a.tipo + " y " + b.tipo);\r\n                return new Valor("error", "");\r\n            }\r\n        }\r\n        StringBuilder cod \= new StringBuilder();\r\n        cod.append(a.codigo);\r\n        cod.append("    addi $sp, $sp, -4\\n    sw   $t0, 0($sp)\\n");\r\n        cod.append(b.codigo);\r\n        cod.append("    move $t1, $t0\\n    lw   $t0, 0($sp)\\n    addi $sp, $sp, 4\\n");\r\n        switch (op) {\r\n            case "+"\: cod.append("    add  $t0, $t0, $t1\\n"); break;\r\n            case "-"\: cod.append("    sub  $t0, $t0, $t1\\n"); break;\r\n            case "*"\: cod.append("    mul  $t0, $t0, $t1\\n"); break;\r\n            case "/"\: cod.append("    div  $t0, $t1\\n    mflo $t0\\n"); break;\r\n            case "%"\: cod.append("    div  $t0, $t1\\n    mfhi $t0\\n"); break;\r\n        }\r\n        return new Valor("int", cod.toString());\r\n    }\r\n\r\n    Valor operarRelacional(Valor a, Valor b, String instMips, String opTexto, boolean soloEnteros, int linea) {\r\n        if (\!a.tipo.equals("error") && \!b.tipo.equals("error")) {\r\n            if (soloEnteros && (\!a.tipo.equals("int") || \!b.tipo.equals("int"))) {\r\n                errorSemantico(linea, "el operador '" + opTexto + "' requiere operandos int, pero recibi\u00F3 " + a.tipo + " y " + b.tipo);\r\n                return new Valor("error", "");\r\n            } else if (\!soloEnteros && \!a.tipo.equals(b.tipo)) {\r\n                errorSemantico(linea, "no se pueden comparar tipos distintos (" + a.tipo + " y " + b.tipo + ") con '" + opTexto + "'");\r\n                return new Valor("error", "");\r\n            }\r\n        }\r\n        String cod \= a.codigo\r\n                   + "    addi $sp, $sp, -4\\n    sw   $t0, 0($sp)\\n"\r\n                   + b.codigo\r\n                   + "    move $t1, $t0\\n    lw   $t0, 0($sp)\\n    addi $sp, $sp, 4\\n"\r\n                   + "    " + instMips + "  $t0, $t0, $t1\\n";\r\n        return new Valor("boolean", cod);\r\n    }\r\n\r\n    List<String> tokensEsperados() {\r\n        List<String> esperados \= new ArrayList<>();\r\n        short[] fila \= action_tab[((Symbol) stack.peek()).parse_state];\r\n        for (int i \= 0; i + 1 < fila.length; i +\= 2)\r\n            if (fila[i] > sym.error && fila[i + 1] \!\= 0) esperados.add(sym.terminalNames[fila[i]]);\r\n        return esperados;\r\n    }\r\n\r\n    @Override\r\n    public void syntax_error(Symbol s) {\r\n        List<String> esperados \= tokensEsperados();\r\n        if (s.sym \=\= sym.EOF)\r\n            System.out.println("Error sint\u00E1ctico\: el archivo termin\u00F3 antes de tiempo. Se esperaba\: " + esperados);\r\n        else\r\n            System.out.println("Error sint\u00E1ctico en l\u00EDnea " + s.left + ", columna " + s.right + "\: no se esperaba "\r\n                               + sym.terminalNames[s.sym] + " ('" + s.value + "'). Se esperaba\: " + esperados);\r\n    }\r\n\r\n    @Override\r\n    public void unrecovered_syntax_error(Symbol s) {\r\n        System.exit(1);\r\n    }\r\n\r\n    public static void main(String[] args) throws Exception {\r\n        String entrada \= args.length > 0 ? args[0] \: "programa.txt";\r\n        String salida \= entrada.replaceAll("\\\\.[^.]*$", "") + ".asm";\r\n\r\n        System.out.println("\=\=\= Tokens (JFlex) \=\=\=");\r\n        Lexer lexer \= new Lexer(new FileReader(entrada));\r\n        for (Symbol t \= lexer.next_token(); t.sym \!\= sym.EOF; t \= lexer.next_token())\r\n            System.out.printf("  l\u00EDnea %-3d %-14s %s%n", t.left, sym.terminalNames[t.sym], t.value);\r\n\r\n        Parser parser \= new Parser(new Lexer(new FileReader(entrada)));\r\n        String codigo \= (String) parser.parse().value;\r\n        System.out.println("\\n\=\=\= An\u00E1lisis sint\u00E1ctico (CUP)\: OK \=\=\=");\r\n\r\n        System.out.println("\\n\=\=\= Tabla de s\u00EDmbolos \=\=\=");\r\n        for (Map.Entry<String, String> e \: parser.tablaDeSimbolos.entrySet())\r\n            System.out.println("  " + e.getKey() + " \: " + e.getValue());\r\n        if (\!parser.erroresSemanticos.isEmpty()) {\r\n            System.out.println();\r\n            for (String e \: parser.erroresSemanticos) System.out.println(e);\r\n            System.exit(1);\r\n        }\r\n        System.out.println("\\n\=\=\= An\u00E1lisis sem\u00E1ntico\: OK \=\=\=");\r\n\r\n        try (FileWriter w \= new FileWriter(salida)) {\r\n            w.write(".data\\n" + parser.datos + "\\n.text\\n.globl main\\nmain\:\\n" + codigo\r\n                    + "    li   $v0, 10          \# fin del programa\\n    syscall\\n");\r\n        }\r\n        System.out.println("\\n\=\=\= C\u00F3digo MIPS generado en\: " + salida + " \=\=\=");\r\n    }\r\n\:};\r\n\r\nterminal          IMPRIMIR, IF, ELSE, WHILE, BOOLEAN, INT;\r\nterminal          MAS, MENOS, POR, DIV, MOD, INC;\r\nterminal          MAYOR, MENOR, MAYIG, MENIG, IGUAL, DIST;\r\nterminal          ASIG, COMA, PYC, LPAREN, RPAREN, LLAVEA, LLAVEC;\r\nterminal String   ID, CADENA;\r\nterminal Boolean  LIT_BOOLEANO;\r\nterminal Integer  LIT_ENTERO;\r\n\r\nnon terminal String                  programa, lista, sentencia, declaracion, asignacion, incremento;\r\nnon terminal String                  impresion, contenido_impr, parte_impr, condicional, bucle_while, bloque, tipo;\r\nnon terminal List<Parser.DeclItem>   lista_vars;\r\nnon terminal Parser.DeclItem         var_decl;\r\nnon terminal Parser.Valor            condicion, expr, termino, factor;\r\n\r\nstart with programa;\r\n\r\nprograma    \:\:\= lista\:c                                   {\: RESULT \= c; \:}\r\n              ;\r\n\r\nlista       \:\:\= lista\:a sentencia\:b                       {\: RESULT \= a + b; \:}\r\n              | sentencia\:s                               {\: RESULT \= s; \:}\r\n              ;\r\n\r\nsentencia   \:\:\= declaracion\:s                             {\: RESULT \= s; \:}\r\n              | asignacion\:s                              {\: RESULT \= s; \:}\r\n              | incremento\:s                              {\: RESULT \= s; \:}\r\n              | impresion\:s                               {\: RESULT \= s; \:}\r\n              | condicional\:s                             {\: RESULT \= s; \:}\r\n              | bucle_while\:s                             {\: RESULT \= s; \:}\r\n              ;\r\n\r\n/* ---------- Declaraci\u00F3n simple y m\u00FAltiple\: int a, b \= 0; ---------- */\r\ndeclaracion \:\:\= tipo\:t lista_vars\:vars PYC\r\n                {\:\r\n                    StringBuilder cod \= new StringBuilder();\r\n                    for (Parser.DeclItem item \: vars) {\r\n                        if (parser.tablaDeSimbolos.containsKey(item.id)) {\r\n                            parser.errorSemantico(item.linea, "la variable '" + item.id + "' ya fue declarada");\r\n                        } else {\r\n                            parser.tablaDeSimbolos.put(item.id, t);\r\n                            parser.datos.append("    v_" + item.id + "\: .word 0\\n");\r\n                            if (item.valor \!\= null) {\r\n                                if (\!item.valor.tipo.equals("error") && \!t.equals(item.valor.tipo)) {\r\n                                    parser.errorSemantico(item.linea, "no se puede asignar un valor " + item.valor.tipo\r\n                                                                      + " a la variable '" + item.id + "' de tipo " + t);\r\n                                }\r\n                                cod.append("    \# " + t + " " + item.id + " \= ...\\n")\r\n                                   .append(item.valor.codigo)\r\n                                   .append("    sw   $t0, v_" + item.id + "\\n");\r\n                            } else {\r\n                                cod.append("    \# " + t + " " + item.id + " (inicializada en 0)\\n");\r\n                            }\r\n                        }\r\n                    }\r\n                    RESULT \= cod.toString();\r\n                \:}\r\n              ;\r\n\r\nlista_vars  \:\:\= lista_vars\:l COMA var_decl\:v              {\: l.add(v); RESULT \= l; \:}\r\n              | var_decl\:v                                {\: List<Parser.DeclItem> l \= new ArrayList<>(); l.add(v); RESULT \= l; \:}\r\n              ;\r\n\r\nvar_decl    \:\:\= ID\:id ASIG expr\:v                         {\: RESULT \= new Parser.DeclItem(id, idleft, v); \:}\r\n              | ID\:id                                     {\: RESULT \= new Parser.DeclItem(id, idleft, null); \:}\r\n              ;\r\n\r\ntipo        \:\:\= BOOLEAN                                   {\: RESULT \= "boolean"; \:}\r\n              | INT                                       {\: RESULT \= "int"; \:}\r\n              ;\r\n\r\n/* ---------- Asignaci\u00F3n\: a \= expr; ---------- */\r\nasignacion  \:\:\= ID\:id ASIG expr\:v PYC\r\n                {\:\r\n                    String t \= parser.tablaDeSimbolos.get(id);\r\n                    if (t \=\= null) {\r\n                        parser.errorSemantico(idleft, "la variable '" + id + "' no fue declarada");\r\n                    } else if (\!v.tipo.equals("error") && \!t.equals(v.tipo)) {\r\n                        parser.errorSemantico(idleft, "no se puede asignar un valor " + v.tipo\r\n                                                      + " a la variable '" + id + "' de tipo " + t);\r\n                    }\r\n                    RESULT \= "    \# " + id + " \= ...\\n"\r\n                           + v.codigo\r\n                           + "    sw   $t0, v_" + id + "\\n";\r\n                \:}\r\n              ;\r\n\r\n/* ---------- Incremento\: i++; ---------- */\r\nincremento  \:\:\= ID\:id INC PYC\r\n                {\:\r\n                    String t \= parser.tablaDeSimbolos.get(id);\r\n                    if (t \=\= null) {\r\n                        parser.errorSemantico(idleft, "la variable '" + id + "' no fue declarada");\r\n                    } else if (\!t.equals("int")) {\r\n                        parser.errorSemantico(idleft, "el operador '++' solo se aplica a variables int, pero '" + id + "' es " + t);\r\n                    }\r\n                    RESULT \= "    \# " + id + "++\\n"\r\n                           + "    lw   $t0, v_" + id + "\\n"\r\n                           + "    addi $t0, $t0, 1\\n"\r\n                           + "    sw   $t0, v_" + id + "\\n";\r\n                \:}\r\n              ;\r\n\r\n/* ---------- Impresi\u00F3n de cadenas, expresiones y concatenaciones con '+' ---------- */\r\nimpresion       \:\:\= IMPRIMIR LPAREN contenido_impr\:c RPAREN PYC\r\n                    {\:\r\n                        RESULT \= "    \# System.Out.Println(...)\\n"\r\n                               + c\r\n                               + "    li   $a0, 10          \# salto de l\u00EDnea\\n"\r\n                               + "    li   $v0, 11          \# syscall print_char\\n"\r\n                               + "    syscall\\n";\r\n                    \:}\r\n                  ;\r\n\r\ncontenido_impr  \:\:\= contenido_impr\:c MAS parte_impr\:p\r\n                    {\:\r\n                        RESULT \= c + p;\r\n                    \:}\r\n                  | parte_impr\:p\r\n                    {\:\r\n                        RESULT \= p;\r\n                    \:}\r\n                  ;\r\n\r\nparte_impr      \:\:\= CADENA\:s\r\n                    {\:\r\n                        String etiqueta \= parser.nuevaEtiqueta("texto");\r\n                        parser.datos.append("    " + etiqueta + "\: .asciiz \\"" + s + "\\"\\n");\r\n                        RESULT \= "    la   $a0, " + etiqueta + "\\n"\r\n                               + "    li   $v0, 4           \# syscall print_string\\n"\r\n                               + "    syscall\\n";\r\n                    \:}\r\n                  | termino\:t\r\n                    {\:\r\n                        if (t.tipo.equals("boolean")) {\r\n                            String etTrue \= parser.nuevaEtiqueta("impr_true_");\r\n                            String etFin \= parser.nuevaEtiqueta("impr_fin_");\r\n                            String etTxtTrue \= parser.nuevaEtiqueta("txt_true_");\r\n                            String etTxtFalse \= parser.nuevaEtiqueta("txt_false_");\r\n                            parser.datos.append("    " + etTxtTrue + "\: .asciiz \\"true\\"\\n");\r\n                            parser.datos.append("    " + etTxtFalse + "\: .asciiz \\"false\\"\\n");\r\n                            RESULT \= t.codigo\r\n                                   + "    bnez $t0, " + etTrue + "\\n"\r\n                                   + "    la   $a0, " + etTxtFalse + "\\n"\r\n                                   + "    li   $v0, 4\\n"\r\n                                   + "    syscall\\n"\r\n                                   + "    j    " + etFin + "\\n"\r\n                                   + etTrue + "\:\\n"\r\n                                   + "    la   $a0, " + etTxtTrue + "\\n"\r\n                                   + "    li   $v0, 4\\n"\r\n                                   + "    syscall\\n"\r\n                                   + etFin + "\:\\n";\r\n                        } else {\r\n                            RESULT \= t.codigo\r\n                                   + "    move $a0, $t0\\n"\r\n                                   + "    li   $v0, 1           \# syscall print_int\\n"\r\n                                   + "    syscall\\n";\r\n                        }\r\n                    \:}\r\n                  ;\r\n\r\n/* ---------- Condicional IF / ELSE ---------- */\r\ncondicional \:\:\= IF LPAREN condicion\:c RPAREN bloque\:entonces\r\n                {\:\r\n                    if (\!c.tipo.equals("boolean") && \!c.tipo.equals("error"))\r\n                        parser.errorSemantico(cleft, "la condici\u00F3n del IF tiene que ser boolean, pero es " + c.tipo);\r\n                    String fin \= parser.nuevaEtiqueta("fin_if");\r\n                    RESULT \= "    \# IF\\n" + c.codigo\r\n                           + "    beqz $t0, " + fin + "\\n"\r\n                           + entonces\r\n                           + fin + "\:\\n";\r\n                \:}\r\n              | IF LPAREN condicion\:c RPAREN bloque\:entonces ELSE bloque\:sino\r\n                {\:\r\n                    if (\!c.tipo.equals("boolean") && \!c.tipo.equals("error"))\r\n                        parser.errorSemantico(cleft, "la condici\u00F3n del IF tiene que ser boolean, pero es " + c.tipo);\r\n                    String etElse \= parser.nuevaEtiqueta("else_"), fin \= parser.nuevaEtiqueta("fin_if");\r\n                    RESULT \= "    \# IF-ELSE\\n" + c.codigo\r\n                           + "    beqz $t0, " + etElse + "\\n"\r\n                           + entonces\r\n                           + "    j    " + fin + "\\n"\r\n                           + etElse + "\:\\n"\r\n                           + sino\r\n                           + fin + "\:\\n";\r\n                \:}\r\n              ;\r\n\r\n/* ---------- Bucle WHILE ---------- */\r\nbucle_while \:\:\= WHILE LPAREN condicion\:c RPAREN bloque\:cuerpo\r\n                {\:\r\n                    if (\!c.tipo.equals("boolean") && \!c.tipo.equals("error"))\r\n                        parser.errorSemantico(cleft, "la condici\u00F3n del WHILE tiene que ser boolean, pero es " + c.tipo);\r\n                    String ini \= parser.nuevaEtiqueta("inicio_while_");\r\n                    String fin \= parser.nuevaEtiqueta("fin_while_");\r\n                    RESULT \= "    \# WHILE\\n"\r\n                           + ini + "\:\\n"\r\n                           + c.codigo\r\n                           + "    beqz $t0, " + fin + "\\n"\r\n                           + cuerpo\r\n                           + "    j    " + ini + "\\n"\r\n                           + fin + "\:\\n";\r\n                \:}\r\n              ;\r\n\r\ncondicion   \:\:\= expr\:a MAYOR expr\:b                       {\: RESULT \= parser.operarRelacional(a, b, "sgt", ">", true, aleft); \:}\r\n              | expr\:a MENOR expr\:b                       {\: RESULT \= parser.operarRelacional(a, b, "slt", "<", true, aleft); \:}\r\n              | expr\:a MAYIG expr\:b                       {\: RESULT \= parser.operarRelacional(a, b, "sge", ">\=", true, aleft); \:}\r\n              | expr\:a MENIG expr\:b                       {\: RESULT \= parser.operarRelacional(a, b, "sle", "<\=", true, aleft); \:}\r\n              | expr\:a IGUAL expr\:b                       {\: RESULT \= parser.operarRelacional(a, b, "seq", "\=\=", false, aleft); \:}\r\n              | expr\:a DIST  expr\:b                       {\: RESULT \= parser.operarRelacional(a, b, "sne", "\!\=", false, aleft); \:}\r\n              | expr\:e                                    {\: RESULT \= e; \:}\r\n              ;\r\n\r\nexpr        \:\:\= expr\:a MAS termino\:b                      {\: RESULT \= parser.operarAritmetico(a, b, "+", aleft); \:}\r\n              | expr\:a MENOS termino\:b                    {\: RESULT \= parser.operarAritmetico(a, b, "-", aleft); \:}\r\n              | termino\:t                                 {\: RESULT \= t; \:}\r\n              ;\r\n\r\ntermino     \:\:\= termino\:a POR factor\:b                    {\: RESULT \= parser.operarAritmetico(a, b, "*", aleft); \:}\r\n              | termino\:a DIV factor\:b                    {\: RESULT \= parser.operarAritmetico(a, b, "/", aleft); \:}\r\n              | termino\:a MOD factor\:b                    {\: RESULT \= parser.operarAritmetico(a, b, "%", aleft); \:}\r\n              | factor\:f                                  {\: RESULT \= f; \:}\r\n              ;\r\n\r\nfactor      \:\:\= LPAREN expr\:e RPAREN                      {\: RESULT \= e; \:}\r\n              | ID\:id\r\n                {\:\r\n                    String t \= parser.tablaDeSimbolos.get(id);\r\n                    if (t \=\= null) {\r\n                        parser.errorSemantico(idleft, "la variable '" + id + "' no fue declarada");\r\n                        t \= "error";\r\n                    }\r\n                    RESULT \= new Parser.Valor(t, "    lw   $t0, v_" + id + "\\n");\r\n                \:}\r\n              | LIT_ENTERO\:n                              {\: RESULT \= new Parser.Valor("int", "    li   $t0, " + n + "\\n"); \:}\r\n              | LIT_BOOLEANO\:b                            {\: RESULT \= new Parser.Valor("boolean", "    li   $t0, " + (b ? 1 \: 0) + "\\n"); \:}\r\n              ;\r\n\r\nbloque      \:\:\= LLAVEA lista\:c LLAVEC                     {\: RESULT \= c; \:}\r\n              | LLAVEA LLAVEC                             {\: RESULT \= ""; \:}\r\n              ;
manual.flex=import java_cup.runtime.Symbol;\r\n\r\n%%\r\n\r\n%class Lexer\r\n%public\r\n%unicode\r\n%cup\r\n%line\r\n%column\r\n\r\n%{\r\n    private Symbol token(int tipo) {\r\n        return new Symbol(tipo, yyline + 1, yycolumn + 1, yytext());\r\n    }\r\n    private Symbol token(int tipo, Object valor) {\r\n        return new Symbol(tipo, yyline + 1, yycolumn + 1, valor);\r\n    }\r\n%}\r\n\r\nLETRA      \= [a-zA-Z_]\r\nDIGITO     \= [0-9]\r\nESPACIO    \= [ \\t\\r\\n]+\r\nCOMENTARIO \= "//" [^\\n]*\r\n\r\n%%\r\n\r\n"System.Out.Println"        { return token(sym.IMPRIMIR); }\r\n"IF"                        { return token(sym.IF); }\r\n"ELSE"                      { return token(sym.ELSE); }\r\n"WHILE" | "while"           { return token(sym.WHILE); }\r\n"boolean"                   { return token(sym.BOOLEAN); }\r\n"int"                       { return token(sym.INT); }\r\n"true"                      { return token(sym.LIT_BOOLEANO, Boolean.TRUE); }\r\n"false"                     { return token(sym.LIT_BOOLEANO, Boolean.FALSE); }\r\n\r\n{LETRA}({LETRA}|{DIGITO})*  { return token(sym.ID, yytext()); }\r\n{DIGITO}+                   { return token(sym.LIT_ENTERO, Integer.valueOf(yytext())); }\r\n\\"[^\\"\\n]*\\"                { return token(sym.CADENA, yytext().substring(1, yytext().length() - 1)); }\r\n\r\n"++"                        { return token(sym.INC); }\r\n">\="                        { return token(sym.MAYIG); }\r\n"<\="                        { return token(sym.MENIG); }\r\n"\=\="                        { return token(sym.IGUAL); }\r\n"\!\="                        { return token(sym.DIST); }\r\n">"                         { return token(sym.MAYOR); }\r\n"<"                         { return token(sym.MENOR); }\r\n"+"                         { return token(sym.MAS); }\r\n"-"                         { return token(sym.MENOS); }\r\n"*"                         { return token(sym.POR); }\r\n"/"                         { return token(sym.DIV); }\r\n"%"                         { return token(sym.MOD); }\r\n"\="                         { return token(sym.ASIG); }\r\n","                         { return token(sym.COMA); }\r\n";"                         { return token(sym.PYC); }\r\n"("                         { return token(sym.LPAREN); }\r\n")"                         { return token(sym.RPAREN); }\r\n"{"                         { return token(sym.LLAVEA); }\r\n"}"                         { return token(sym.LLAVEC); }\r\n\r\n{ESPACIO}                   { /* ignorar */ }\r\n{COMENTARIO}                { /* ignorar */ }\r\n\\uFEFF                      { /* ignorar BOM */ }\r\n\r\n[^]                         { System.out.println("Error l\u00E9xico en l\u00EDnea " + (yyline + 1) + ", columna "\r\n                                                 + (yycolumn + 1) + "\: car\u00E1cter no reconocido '" + yytext() + "'");\r\n                              System.exit(1); }
modo=manual
programa=\uFEFFboolean flag \= true;\nint num \= 5;\nint num2 \= 10;\nint total \= num + num2;\nSystem.Out.Println("Inicio del Programa");\nSystem.Out.Println("numero\: " + num);\nSystem.Out.Println("total\: " + total);\nIF (flag){\n    System.Out.Println ("Hola Mundo\!");\n}\nELSE {\n    System.Out.Println ("Error");\n}\nSystem.Out.Println("Final del Programa");\r\n
sem.advertirSinInicializar=false
sem.aritmetica.0.0=ERROR
sem.aritmetica.0.1=ERROR
sem.aritmetica.0.2=ERROR
sem.aritmetica.0.3=ERROR
sem.aritmetica.1.0=ERROR
sem.aritmetica.1.1=ERROR
sem.aritmetica.1.2=ERROR
sem.aritmetica.1.3=ERROR
