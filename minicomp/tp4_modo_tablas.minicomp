lex.definiciones=/* NOMBRE \= expresión regular   ->   se usa en la tabla como {NOMBRE} */\nLETRA      \= [a-zA-Z_]\nDIGITO     \= [0-9]\nESPACIO    \= [ \\t\\r\\n]+\nCOMENTARIO \= "//" [^\\n]*
manual.cup=/* \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\n *  ANALIZADOR SINTÁCTICO + SEMÁNTICO + GENERACIÓN DE CÓDIGO     Herramienta\: CUP\n *\n *  CUP lee este archivo y genera\:\n *    - Parser.java \: un parser LALR(1) (ascendente) para la gramática de abajo\n *    - sym.java    \: los números de cada token (los usa el Lexer)\n *\n *  Cada producción tiene una ACCIÓN {\: ... \:} con código Java que se ejecuta\n *  cuando el parser REDUCE esa producción. En las acciones se hace\:\n *    - el análisis SEMÁNTICO (tabla de símbolos, chequeo de tipos)\n *    - la GENERACIÓN DE CÓDIGO MIPS\: cada no terminal devuelve (RESULT) el\n *      código de su parte del programa, y el padre lo junta con el de sus hijos.\n * \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\= */\n\nimport java_cup.runtime.Symbol;\nimport java.io.FileReader;\nimport java.io.FileWriter;\nimport java.util.ArrayList;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\n\nparser code {\:\n\n    /* ---------- Tabla de símbolos\: nombre de variable -> tipo ("boolean" o "int") ---------- */\n    Map<String, String> tablaDeSimbolos \= new LinkedHashMap<>();\n\n    /* ---------- Errores semánticos encontrados ---------- */\n    List<String> erroresSemanticos \= new ArrayList<>();\n\n    /* ---------- Sección .data del programa MIPS (variables y textos) ---------- */\n    StringBuilder datos \= new StringBuilder();\n    int contador \= 0;\n\n    /* Un valor (literal o variable)\: su tipo y el código MIPS que lo carga en $t0 */\n    static class Valor {\n        String tipo, codigo;\n        Valor(String tipo, String codigo) { this.tipo \= tipo; this.codigo \= codigo; }\n    }\n\n    void errorSemantico(int linea, String mensaje) {\n        erroresSemanticos.add("Error semántico en línea " + linea + "\: " + mensaje);\n    }\n\n    String nuevaEtiqueta(String prefijo) {\n        return prefijo + (contador++);\n    }\n\n    /* ---------- Errores sintácticos ---------- */\n\n    /* Tokens que el parser podía aceptar en el estado actual\: se leen de la fila\n       de la TABLA DE ACCIONES LALR (pares token, acción) del estado en el tope de la pila. */\n    List<String> tokensEsperados() {\n        List<String> esperados \= new ArrayList<>();\n        short[] fila \= action_tab[((Symbol) stack.peek()).parse_state];\n        for (int i \= 0; i + 1 < fila.length; i +\= 2)\n            if (fila[i] > sym.error && fila[i + 1] \!\= 0) esperados.add(sym.terminalNames[fila[i]]);\n        return esperados;\n    }\n\n    @Override\n    public void syntax_error(Symbol s) {\n        List<String> esperados \= tokensEsperados();\n        if (s.sym \=\= sym.EOF)\n            System.out.println("Error sintáctico\: el archivo terminó antes de tiempo. Se esperaba\: " + esperados);\n        else\n            System.out.println("Error sintáctico en línea " + s.left + ", columna " + s.right + "\: no se esperaba "\n                               + sym.terminalNames[s.sym] + " ('" + s.value + "'). Se esperaba\: " + esperados);\n    }\n\n    @Override\n    public void unrecovered_syntax_error(Symbol s) {\n        System.exit(1);\n    }\n\n    /* ---------- Programa principal\:  java Parser programa.txt ---------- */\n    public static void main(String[] args) throws Exception {\n        String entrada \= args.length > 0 ? args[0] \: "programa.txt";\n        String salida \= entrada.replaceAll("\\\\.[^.]*$", "") + ".asm";\n\n        // 1) solo para mostrar\: los tokens que encuentra el analizador léxico\n        System.out.println("\=\=\= Tokens (JFlex) \=\=\=");\n        Lexer lexer \= new Lexer(new FileReader(entrada));\n        for (Symbol t \= lexer.next_token(); t.sym \!\= sym.EOF; t \= lexer.next_token())\n            System.out.printf("  línea %-3d %-14s %s%n", t.left, sym.terminalNames[t.sym], t.value);\n\n        // 2) análisis sintáctico; al reducir cada regla se ejecutan sus acciones\n        Parser parser \= new Parser(new Lexer(new FileReader(entrada)));\n        String codigo \= (String) parser.parse().value;\n        System.out.println("\\n\=\=\= Análisis sintáctico (CUP)\: OK \=\=\=");\n\n        // 3) resultado del análisis semántico\n        System.out.println("\\n\=\=\= Tabla de símbolos \=\=\=");\n        for (Map.Entry<String, String> e \: parser.tablaDeSimbolos.entrySet())\n            System.out.println("  " + e.getKey() + " \: " + e.getValue());\n        if (\!parser.erroresSemanticos.isEmpty()) {\n            System.out.println();\n            for (String e \: parser.erroresSemanticos) System.out.println(e);\n            System.exit(1);\n        }\n        System.out.println("\\n\=\=\= Análisis semántico\: OK \=\=\=");\n\n        // 4) programa MIPS para MARS\n        try (FileWriter w \= new FileWriter(salida)) {\n            w.write(".data\\n" + parser.datos + "\\n.text\\nmain\:\\n" + codigo\n                    + "    li   $v0, 10          \# fin del programa\\n    syscall\\n");\n        }\n        System.out.println("\\n\=\=\= Código MIPS generado en\: " + salida + " \=\=\=");\n    }\n\:};\n\n/* \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\n *  TERMINALES (los tokens que devuelve el Lexer)\n * \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\= */\nterminal          IMPRIMIR, IF, ELSE, BOOLEAN, INT;\nterminal          ASIG, PYC, LPAREN, RPAREN, LLAVEA, LLAVEC;\nterminal String   ID, CADENA;\nterminal Boolean  LIT_BOOLEANO;\nterminal Integer  LIT_ENTERO;\n\n/* \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\n *  NO TERMINALES (el tipo es lo que devuelve RESULT)\n * \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\= */\nnon terminal String        programa, lista, sentencia, declaracion, impresion, condicional, bloque, tipo;\nnon terminal Parser.Valor  valor, condicion;\n\nstart with programa;\n\n/* \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\n *  GRAMÁTICA\n * \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\= */\n\nprograma    \:\:\= lista\:c                                   {\: RESULT \= c; \:}\n              ;\n\nlista       \:\:\= lista\:a sentencia\:b                       {\: RESULT \= a + b; \:}\n              | sentencia\:s                               {\: RESULT \= s; \:}\n              ;\n\nsentencia   \:\:\= declaracion\:s                             {\: RESULT \= s; \:}\n              | impresion\:s                               {\: RESULT \= s; \:}\n              | condicional\:s                             {\: RESULT \= s; \:}\n              ;\n\n/* ---------- boolean flag \= true; ---------- */\ndeclaracion \:\:\= tipo\:t ID\:id ASIG valor\:v PYC\n                {\:\n                    if (parser.tablaDeSimbolos.containsKey(id))\n                        parser.errorSemantico(idleft, "la variable '" + id + "' ya fue declarada");\n                    else if (\!t.equals(v.tipo))\n                        parser.errorSemantico(idleft, "no se puede asignar un valor " + v.tipo\n                                                      + " a la variable '" + id + "' de tipo " + t);\n                    parser.tablaDeSimbolos.putIfAbsent(id, t);\n                    parser.datos.append("    v_" + id + "\: .word 0\\n");\n                    RESULT \= "    \# " + t + " " + id + " \= ...\\n"\n                           + v.codigo\n                           + "    sw   $t0, v_" + id + "\\n";\n                \:}\n              ;\n\ntipo        \:\:\= BOOLEAN                                   {\: RESULT \= "boolean"; \:}\n              | INT                                       {\: RESULT \= "int"; \:}\n              ;\n\nvalor       \:\:\= LIT_BOOLEANO\:b       {\: RESULT \= new Parser.Valor("boolean", "    li   $t0, " + (b ? 1 \: 0) + "\\n"); \:}\n              | LIT_ENTERO\:n         {\: RESULT \= new Parser.Valor("int", "    li   $t0, " + n + "\\n"); \:}\n              ;\n\n/* ---------- System.Out.Println("texto"); ---------- */\nimpresion   \:\:\= IMPRIMIR LPAREN CADENA\:s RPAREN PYC\n                {\:\n                    String etiqueta \= parser.nuevaEtiqueta("texto");\n                    parser.datos.append("    " + etiqueta + "\: .asciiz \\"" + s + "\\\\n\\"\\n");\n                    RESULT \= "    \# System.Out.Println(\\"" + s + "\\")\\n"\n                           + "    la   $a0, " + etiqueta + "\\n"\n                           + "    li   $v0, 4           \# syscall\: imprimir texto\\n"\n                           + "    syscall\\n";\n                \:}\n              ;\n\n/* ---------- IF (condicion) { ... } ELSE { ... } ---------- */\ncondicional \:\:\= IF LPAREN condicion\:c RPAREN bloque\:entonces\n                {\:\n                    if (\!c.tipo.equals("boolean") && \!c.tipo.equals("error"))\n                        parser.errorSemantico(cleft, "la condición del IF tiene que ser boolean, pero es " + c.tipo);\n                    String fin \= parser.nuevaEtiqueta("fin_if");\n                    RESULT \= "    \# IF\\n" + c.codigo\n                           + "    beqz $t0, " + fin + "      \# si la condición es falsa, saltar\\n"\n                           + entonces\n                           + fin + "\:\\n";\n                \:}\n              | IF LPAREN condicion\:c RPAREN bloque\:entonces ELSE bloque\:sino\n                {\:\n                    if (\!c.tipo.equals("boolean") && \!c.tipo.equals("error"))\n                        parser.errorSemantico(cleft, "la condición del IF tiene que ser boolean, pero es " + c.tipo);\n                    String etElse \= parser.nuevaEtiqueta("else"), fin \= parser.nuevaEtiqueta("fin_if");\n                    RESULT \= "    \# IF\\n" + c.codigo\n                           + "    beqz $t0, " + etElse + "        \# si la condición es falsa, ir al ELSE\\n"\n                           + entonces\n                           + "    j    " + fin + "\\n"\n                           + etElse + "\:                        \# ELSE\\n"\n                           + sino\n                           + fin + "\:\\n";\n                \:}\n              ;\n\ncondicion   \:\:\= ID\:id\n                {\:\n                    String t \= parser.tablaDeSimbolos.get(id);\n                    if (t \=\= null) {\n                        parser.errorSemantico(idleft, "la variable '" + id + "' no fue declarada");\n                        t \= "error";   // para no informar otro error por la misma causa\n                    }\n                    RESULT \= new Parser.Valor(t, "    lw   $t0, v_" + id + "\\n");\n                \:}\n              | valor\:v                                   {\: RESULT \= v; \:}\n              ;\n\nbloque      \:\:\= LLAVEA lista\:c LLAVEC                     {\: RESULT \= c; \:}\n              | LLAVEA LLAVEC                             {\: RESULT \= ""; \:}\n              ;\n
manual.flex=/* \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\n *  ANALIZADOR LÉXICO                                    Herramienta\: JFlex\n *\n *  JFlex lee este archivo y genera Lexer.java\: un autómata que recorre el\n *  programa fuente carácter por carácter y lo agrupa en TOKENS.\n *\n *  Regla de desempate\:\n *    1) gana el lexema MÁS LARGO\n *    2) a igual longitud, gana la regla que está MÁS ARRIBA\n *  Por eso las palabras reservadas (IF, ELSE, boolean...) van antes que ID.\n * \=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\=\= */\n\nimport java_cup.runtime.Symbol;\n\n%%\n\n%class Lexer\n%public\n%unicode\n%cup\n%line\n%column\n\n%{\n    /* Crea un token. sym.XXX son los números de token que genera CUP en sym.java */\n    private Symbol token(int tipo) {\n        return new Symbol(tipo, yyline + 1, yycolumn + 1, yytext());\n    }\n\n    private Symbol token(int tipo, Object valor) {\n        return new Symbol(tipo, yyline + 1, yycolumn + 1, valor);\n    }\n%}\n\n/* ---------- Definiciones regulares ---------- */\nLETRA      \= [a-zA-Z_]\nDIGITO     \= [0-9]\nESPACIO    \= [ \\t\\r\\n]+\nCOMENTARIO \= "//" [^\\n]*\n\n%%\n\n/* ---------- Palabras reservadas ---------- */\n"System.Out.Println"        { return token(sym.IMPRIMIR); }\n"IF"                        { return token(sym.IF); }\n"ELSE"                      { return token(sym.ELSE); }\n"boolean"                   { return token(sym.BOOLEAN); }\n"int"                       { return token(sym.INT); }\n"true"                      { return token(sym.LIT_BOOLEANO, Boolean.TRUE); }\n"false"                     { return token(sym.LIT_BOOLEANO, Boolean.FALSE); }\n\n/* ---------- Identificadores y literales ---------- */\n{LETRA}({LETRA}|{DIGITO})*  { return token(sym.ID, yytext()); }\n{DIGITO}+                   { return token(sym.LIT_ENTERO, Integer.valueOf(yytext())); }\n\\"[^\\"\\n]*\\"                { return token(sym.CADENA, yytext().substring(1, yytext().length() - 1)); }\n\n/* ---------- Símbolos ---------- */\n"\="                         { return token(sym.ASIG); }\n";"                         { return token(sym.PYC); }\n"("                         { return token(sym.LPAREN); }\n")"                         { return token(sym.RPAREN); }\n"{"                         { return token(sym.LLAVEA); }\n"}"                         { return token(sym.LLAVEC); }\n\n/* ---------- Se descartan ---------- */\n{ESPACIO}                   { /* ignorar */ }\n{COMENTARIO}                { /* ignorar */ }\n\\uFEFF                      { /* ignorar la marca invisible (BOM) que agregan algunos editores al guardar en UTF-8 */ }\n\n/* ---------- Cualquier otro carácter\: ERROR LÉXICO ---------- */\n[^]                         { System.out.println("Error léxico en línea " + (yyline + 1) + ", columna "\n                                                 + (yycolumn + 1) + "\: carácter no reconocido '" + yytext() + "'");\n                              System.exit(1); }\n
modo=tablas
programa=int a;\nint b \= 0;\na \= 17;\nb \= 5;\nb \= b + 1;\nint resto \= a - (a / b) * b;\nSystem.Out.Println("Valor de a\:");\nSystem.Out.Println(a);\nSystem.Out.Println("Valor de b incrementado\:");\nSystem.Out.Println(b);\nSystem.Out.Println("Resto de a % b\:");\nSystem.Out.Println(resto);\nIF (resto \=\= 5) {\n    System.Out.Println("El resto es 5 (correcto)");\n} ELSE {\n    System.Out.Println("Resto distinto de 5");\n}
